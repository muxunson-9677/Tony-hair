# Server-only. Never expose these with a VITE_ prefix or commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
ACCESS_CODE_HASH=scrypt$v1$N$r$p$salt-hex$derived-key-hex
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
MANAGEMENT_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-at-least-32-random-bytes

# Optional and only for disposable integration-test databases.
TEST_DATABASE_URL=postgresql://user:password@host/disposable_test_database?sslmode=require
